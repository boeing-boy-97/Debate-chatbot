{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/health.js": {
      "maxDuration": 60
    },
    "api/debate/start.js": {
      "maxDuration": 60
    },
    "api/debate/message.js": {
      "maxDuration": 60
    },
    "api/debate/analyze.js": {
      "maxDuration": 60
    },
    "api/debate/evaluate.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
