# OpenAI API key (kept on the backend only — never expose it in frontend code)
OPENAI_API_KEY=

# Optional: model to use (defaults to gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional: custom OpenAI-compatible API base URL (only if you use a proxy)
# OPENAI_BASE_URL=

# Optional: backend port (defaults to 3001)
# PORT=3001

# When the OpenAI API cannot be reached or no key is set, fall back to a local
# (offline) demo debate engine so the app still works end-to-end.
# Set to "false" to enforce OpenAI-only behavior.
ALLOW_OFFLINE_FALLBACK=true
