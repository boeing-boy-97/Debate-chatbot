# Debate AI — environment variables (NAMES only; add your own values, never commit them)
#
# On Vercel: set these in Project Settings → Environment Variables.
# Locally:   copy backend/.env.example to backend/.env for the dev server.

# Required for live AI debate (read on the server only — never expose in frontend code)
OPENAI_API_KEY=

# Optional: model to use (defaults to gpt-4o-mini)
OPENAI_MODEL=

# Optional: custom OpenAI-compatible API base URL (only if you use a proxy)
OPENAI_BASE_URL=

# Optional: when the AI service is unreachable or no key is set, fall back to a
# local demo engine so the app still works end-to-end (default: true).
# Set to "false" to enforce OpenAI-only behavior.
ALLOW_OFFLINE_FALLBACK=

# Optional: local backend port (defaults to 3001; not used on Vercel)
PORT=
