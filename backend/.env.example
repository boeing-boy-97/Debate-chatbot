# OpenAI API key (kept on the backend only — never expose it in frontend code)
OPENAI_API_KEY=

# Optional: model to use (defaults to gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional: custom OpenAI-compatible API base URL (only if you use a proxy)
# OPENAI_BASE_URL=

# Optional: backend port (defaults to 3001)
# PORT=3001
