{
  "name": "debate-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Debate AI — Think. Argue. Improve. Debate an AI opponent that takes the opposite side.",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "test": "npm run test --workspace frontend"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "openai": "^4.77.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
